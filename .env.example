# Copie para .env antes de subir:  cp .env.example .env
# O .env não vai para o Git.

POSTGRES_USER=korp
POSTGRES_PASSWORD=korp

# Porta do Postgres no host. 5442 e não 5432 para não conflitar com
# um Postgres já instalado na máquina. Dentro do Docker continua 5432.
POSTGRES_PORT=5442

ESTOQUE_PORT=7080
FATURAMENTO_PORT=7081
WEB_PORT=4200

# Timeout do faturamento ao chamar o estoque
ESTOQUE_TIMEOUT=3s

# Disjuntor: falhas seguidas até abrir, e quanto tempo fica aberto
DISJUNTOR_FALHAS=5
DISJUNTOR_ESPERA=10s
